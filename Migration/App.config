<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- 실제 배포 시 환경에 맞게 값을 채워 넣으세요. 경로는 예시입니다. -->
        <add key="LogDirectory" value="C:\App\Log" />
        <add key="SourceCsvDirectory" value="C:\App\Data" />
        <add key="SourceFileDirectory" value="C:\App\Source" />
        <add key="TargetFileDirectory" value="C:\App\Target" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
</configuration>
